# Copiar a .env.local para desarrollo local (npm run dev) si se necesita
# apuntar a URLs distintas de las que trae por defecto donatonApi.js.

VITE_BFF_URL=http://localhost:8080
VITE_MS_INVENTARIO=http://localhost:8081
VITE_MS_PEDIDOS=http://localhost:8082

# Debe coincidir con app.security.api-key / API_KEY de los 3 backends.
VITE_API_KEY=smartlogix-dev-key
